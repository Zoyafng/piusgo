# Defaults are for local development. Export values before starting the backend.
MOCK_MODE=true
APP_ENV=development
WEB_ORIGIN=http://localhost:3000
# DATABASE_URL=postgresql+psycopg://piusgo_app:password@127.0.0.1:55432/piusgo
# MIGRATION_DATABASE_URL=postgresql+psycopg://owner:password@127.0.0.1:55432/piusgo
# CAPTCHA_FONT=/path/to/DejaVuSans-Bold.ttf

# Local default: save .eml files privately without external delivery.
MAIL_MODE=mock
# For real mail, export MAIL_MODE=smtp plus the following settings via a secret store.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=your-account
# SMTP_PASSWORD=your-secret
# SMTP_FROM=orders@example.com
